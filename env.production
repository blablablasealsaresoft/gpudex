# GPUDex Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# Application Configuration
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://gpudex:SECURE_PASSWORD_HERE@postgres:5432/gpudex_db
POSTGRES_DB=gpudex_db
POSTGRES_USER=gpudex
POSTGRES_PASSWORD=SECURE_PASSWORD_HERE

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=SECURE_REDIS_PASSWORD_HERE

# Security Configuration
JWT_SECRET_KEY=GENERATE_SECURE_JWT_SECRET_HERE
SECRET_KEY=GENERATE_SECURE_SECRET_KEY_HERE
ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY_HERE

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=alerts@yourdomain.com

# Payment Configuration (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_HOUR=100
DEFAULT_RATE_LIMIT_PER_DAY=1000
PREMIUM_RATE_LIMIT_PER_HOUR=1000
PREMIUM_RATE_LIMIT_PER_DAY=20000

# Provider API Keys (for real integrations)
VAST_AI_API_KEY=your_vast_api_key
RUNPOD_API_KEY=your_runpod_api_key
TENSORDOCK_API_KEY=your_tensordock_api_key
LAMBDA_LABS_API_KEY=your_lambda_labs_api_key
PAPERSPACE_API_KEY=your_paperspace_api_key
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
GCP_PROJECT_ID=your_gcp_project_id
GCP_SERVICE_ACCOUNT_KEY=your_gcp_service_account_json
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# Monitoring & Analytics
PROMETHEUS_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=SECURE_GRAFANA_PASSWORD_HERE
SENTRY_DSN=your_sentry_dsn_here

# Security Headers & CORS
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
SECURE_COOKIES=true
HTTPS_ONLY=true

# Caching Configuration
CACHE_TTL_PRICES=300
CACHE_TTL_ANALYTICS=3600
CACHE_TTL_PROVIDERS=1800

# Feature Flags
ENABLE_REAL_TIME_UPDATES=true
ENABLE_MACHINE_LEARNING=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_ARBITRAGE_DETECTION=true
ENABLE_PRICE_PREDICTIONS=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-gpudex-backups-bucket
BACKUP_S3_REGION=us-east-1

# Performance Configuration
CONNECTION_POOL_SIZE=20
MAX_OVERFLOW=10
POOL_TIMEOUT=30
POOL_RECYCLE=3600

# Alert Configuration
ALERT_CHECK_INTERVAL_MINUTES=5
MAX_ALERTS_PER_USER=20
ALERT_BATCH_SIZE=100

# Legal & Compliance
PRIVACY_POLICY_URL=https://yourdomain.com/privacy
TERMS_OF_SERVICE_URL=https://yourdomain.com/terms
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=365 