# GPUDex Production Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# BLOCKCHAIN CONFIGURATION
# ==========================================

# Your wallet private key for deploying contracts (KEEP SECURE!)
PRIVATE_KEY=your_private_key_here

# Your wallet address to receive platform fees (3% of all transactions)
FEE_RECIPIENT_ADDRESS=your_wallet_address_here

# RPC URLs for different networks
# zkSync Era (RECOMMENDED - Ultra Low Fees!)
ZKSYNC_RPC_URL=https://mainnet.era.zksync.io
ZKSYNC_GOERLI_RPC_URL=https://testnet.era.zksync.dev

# Polygon (Alternative)
POLYGON_RPC_URL=https://polygon-rpc.com/
MUMBAI_RPC_URL=https://polygon-mumbai-bor.publicnode.com

# Ethereum 
MAINNET_RPC_URL=https://mainnet.infura.io/v3/your_infura_key

# Arbitrum & Optimism
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Etherscan v2 API key (works for all chains: Ethereum, Polygon, Arbitrum, Optimism, etc.)
ETHERSCAN_API_KEY=your_etherscan_v2_api_key

# ==========================================
# GPU PROVIDER API KEYS (Use existing ones)
# ==========================================

# Vast.ai - Get from https://console.vast.ai/
VAST_API_KEY=your_vast_api_key

# Lambda Labs - Get from https://lambdalabs.com/
LAMBDA_API_KEY=your_lambda_api_key

# RunPod - Get from https://runpod.io/
RUNPOD_API_KEY=your_runpod_api_key

# ==========================================
# PAYMENT CONFIGURATION
# ==========================================

# Stripe for fiat payments (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs for subscription plans (create in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_starter_monthly_29usd
STRIPE_PRO_PRICE_ID=price_pro_monthly_99usd  
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly_499usd

# Stripe product IDs for one-time GPU rentals
STRIPE_GPU_RENTAL_PRODUCT_ID=prod_gpu_rental_product

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================

# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your_256_bit_secret_key

# API encryption key (generate with: openssl rand -hex 32)
API_ENCRYPTION_KEY=your_encryption_key

# Cross-chain bridge wallet (separate from main wallet for security)
BRIDGE_WALLET_PRIVATE_KEY=your_bridge_wallet_private_key_here

# ==========================================
# PRODUCTION SETTINGS
# ==========================================

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Domain configuration
DOMAIN=gpudex.ai
API_DOMAIN=api.gpudex.ai

# Smart contract addresses (filled after deployment)
# zkSync Era contracts (RECOMMENDED)
ZKSYNC_ESCROW_ADDRESS=
ZKSYNC_TOKEN_ADDRESS=

# Polygon contracts (Alternative)
POLYGON_ESCROW_ADDRESS=0xE0107C4227A38Aae3E5163D691EFb0dc0Eb7598C
POLYGON_TOKEN_ADDRESS=0x386FF386B396ca139E5D2dB6d0b61a0FDd5b4b47

# Ethereum contracts
ETHEREUM_ESCROW_ADDRESS=
ETHEREUM_TOKEN_ADDRESS=

# Current active network (change after deploying to your preferred network)
ESCROW_CONTRACT_ADDRESS=0xE0107C4227A38Aae3E5163D691EFb0dc0Eb7598C  # Currently Polygon
TOKEN_CONTRACT_ADDRESS=0x386FF386B396ca139E5D2dB6d0b61a0FDd5b4b47   # Currently Polygon
PLATFORM_FEE_RECIPIENT=0x0B83154b85B7F6f8ec567d0F3a93B50C8b8C754A
BLOCKCHAIN_NETWORK=polygon  # Options: zksync, polygon, ethereum
CHAIN_ID=137  # 324 for zkSync Era, 137 for Polygon, 1 for Ethereum 