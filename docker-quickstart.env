# GPUDex Docker Quick Start Environment
# This file contains secure defaults for immediate deployment
# For production, update these values with your actual credentials

# Application Configuration
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://gpudex:gpudex_secure_2024@postgres:5432/gpudex_db
POSTGRES_DB=gpudex_db
POSTGRES_USER=gpudex
POSTGRES_PASSWORD=gpudex_secure_2024

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security Configuration (Generated - Replace in production)
JWT_SECRET_KEY=super_secure_jwt_key_change_in_production_12345678901234567890
SECRET_KEY=super_secure_secret_key_change_in_production_12345678901234567890
ENCRYPTION_KEY=secure_encryption_key_change_in_production_123456789012

# Email Configuration (Demo - Replace with real SendGrid key)
SENDGRID_API_KEY=demo_key_replace_with_real_sendgrid_key
FROM_EMAIL=alerts@gpudex.local

# Payment Configuration (Demo - Replace with real Stripe keys)
STRIPE_PUBLISHABLE_KEY=pk_test_demo_key_replace_with_real_stripe_key
STRIPE_SECRET_KEY=sk_test_demo_key_replace_with_real_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_demo_replace_with_real_webhook_secret

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_HOUR=100
DEFAULT_RATE_LIMIT_PER_DAY=1000
PREMIUM_RATE_LIMIT_PER_HOUR=1000
PREMIUM_RATE_LIMIT_PER_DAY=20000

# Monitoring & Analytics
PROMETHEUS_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana_secure_2024

# Security Headers & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
HTTPS_ONLY=false

# Caching Configuration
CACHE_TTL_PRICES=300
CACHE_TTL_ANALYTICS=3600
CACHE_TTL_PROVIDERS=1800

# Feature Flags
ENABLE_REAL_TIME_UPDATES=true
ENABLE_MACHINE_LEARNING=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_ARBITRAGE_DETECTION=true
ENABLE_PRICE_PREDICTIONS=true

# Performance Configuration
CONNECTION_POOL_SIZE=20
MAX_OVERFLOW=10
POOL_TIMEOUT=30
POOL_RECYCLE=3600

# Alert Configuration
ALERT_CHECK_INTERVAL_MINUTES=5
MAX_ALERTS_PER_USER=20
ALERT_BATCH_SIZE=100 