# GPUDex Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://gpudex:gpudex_password@postgres:5432/gpudex_db

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=alerts@gpudex.com

# Application Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=true

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_HOUR=100
DEFAULT_RATE_LIMIT_PER_DAY=1000

# Alert Configuration
ALERT_CHECK_INTERVAL_MINUTES=5
MAX_ALERTS_PER_USER=10

# Security
SECRET_KEY=your_secret_key_here
API_KEY_LENGTH=32

# External APIs (for future provider integrations)
VAST_AI_API_KEY=
RUNPOD_API_KEY=
TENSORDOCK_API_KEY=
LAMBDA_LABS_API_KEY=
PAPERSPACE_API_KEY=

# Monitoring & Analytics
SENTRY_DSN=
ANALYTICS_ENABLED=true

# Deployment
CORS_ORIGINS=http://localhost:3000,https://gpudex.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1,gpudex.onrender.com

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_ARBITRAGE_DETECTION=true
ENABLE_PRICE_HISTORY=true
ENABLE_RATE_LIMITING=true 